      "community": 4,
      "community_name": "Publish Gate and Permissions",
      "norm_label": "main branch publish gate"
    },
    {
      "label": "OIDC id-token Publish Permissions",
      "file_type": "rationale",
      "source_file": ".github/workflows/ci.yml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The workflow grants only contents: read at the top level and adds id-token: write solely on the publish job, following least-privilege so that only the trusted publish path can mint an OIDC token for JSR authentication.",
