    {
      "label": "Main Branch Publish Gate",
      "file_type": "rationale",
      "source_file": ".github/workflows/ci.yml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Publishing is gated on `needs: test` plus `github.event_name == 'push' && github.ref == 'refs/heads/main'`, so pull requests can validate the package with a dry run but never publish, and no release ships without passing lint and tests first.",
